{
  "name": "flow-lite-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that lets Claude drive Google Flow (image and video generation) through its real web page, in its own Chrome profile",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "google-flow",
    "veo",
    "nano-banana",
    "ai-video",
    "playwright"
  ],
  "author": "Fikri Firman Fadilah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikrifirmanf/flow-lite-mcp.git"
  },
  "homepage": "https://github.com/fikrifirmanf/flow-lite-mcp#readme",
  "bugs": {
    "url": "https://github.com/fikrifirmanf/flow-lite-mcp/issues"
  },
  "type": "module",
  "bin": {
    "flow-lite-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "node dist/index.js login",
    "test": "npm run build && node scripts/smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.64.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
